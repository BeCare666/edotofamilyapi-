{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "plugins": [
      "@nestjs/swagger"
    ],
    "assets": [
      {
        "include": "database/sql/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "database/certs/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}
