# Modèle des variables d'environnement de l'API E.doto family.
# Ne JAMAIS écrire de vraie valeur ici : ce fichier est suivi par git.
# Les vraies valeurs vont dans .env (local, ignoré par git) et dans les variables de Render.

NODE_ENV=
PORT=
BASE_URL=
FRONTEND_URL=
FRONTEND_CALLBACK_URL=
FRONTEND_ADMIN_CALLBACK_URL=
SHOP_URL=
DEFAULT_CURRENCY=

# Base TiDB
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SETUP_ON_BOOT=

# Sessions : 64 octets aléatoires
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET_KEY=

# Images et factures
CLOUDINARY_CLOUD_NAME=
